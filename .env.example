# Copy to .env (never commit it) or set these in Railway → Variables.
AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_ROLES_CLAIM=https://authexample.demo/roles   # optional; this is the default
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id          # optional: admin user management
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret
AUTH0_STEP_UP_MAX_AGE=5m   # optional: how recent the admin's MFA must be to add roles
